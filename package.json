{
  "name": "prism",
  "version": "1.31.0",
  "description": "Prism - Your family's digital home. An open-source family dashboard for calendars, tasks, chores, and more.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "Prism Community"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandydargoport/prism.git"
  },
  "keywords": [
    "family-dashboard",
    "home-automation",
    "calendar",
    "react",
    "nextjs",
    "typescript",
    "docker",
    "prism",
    "touchscreen"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "deploy": "bash scripts/deploy-local.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "stats": "bash scripts/stats.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:tz": "bash scripts/test-tz.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:ui-audit": "playwright test e2e/ui-audit.spec.ts && node scripts/ui-audit-board.mjs",
    "test:migration-replay": "bash scripts/test-migration-replay.sh",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:clear": "tsx src/lib/db/clear.ts",
    "db:bundle": "esbuild src/lib/db/seed.ts src/lib/db/clear.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist/db --out-extension:.js=.cjs --external:bcrypt",
    "screenshots:capture": "tsx scripts/capture-screenshots.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "prepare": "husky",
    "prebuild": "node scripts/copy-emoji-assets.mjs && node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-emoji-assets.mjs && node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "astronomy-engine": "2.1.19",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-pwa": "^5.6.0",
    "node-ical": "^0.27.3",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "simple-keyboard": "^3.8.198",
    "suncalc": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdav": "^2.5.0",
    "undici": "^8.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@discordapp/twemoji": "^16.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    }
  }
}
