# Nothing in the project itself checks a commit message. This exists so a
# per-machine hook can: $1 is the path to the drafted message.
#
# Untracked and gitignored, like the other .husky/local hooks.
# Resolved through the shared git dir, so a linked worktree (which has no
# .husky/local of its own) runs the main checkout's hooks too.
local_hooks="$(git rev-parse --path-format=absolute --git-common-dir)/../.husky/local"
if [ -x "$local_hooks/commit-msg" ]; then
  "$local_hooks/commit-msg" "$@"
fi
